rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자 개인 문서 (본인 것만 읽고 쓸 수 있음)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // 초대 코드 -> 가구 ID 매핑 (로그인한 사람은 누구나 코드로 조회 가능, 직접 수정은 불가)
    match /inviteCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // 가구(부부) 문서
    match /households/{householdId} {
      // 처음 만들 때: 본인 uid 하나만 멤버로 넣어서 생성
      allow create: if request.auth != null
                     && request.auth.uid in request.resource.data.members
                     && request.resource.data.members.size() == 1;

      // 이미 멤버인 사람은 자유롭게 읽고 수정 가능
      // 아직 멤버가 아닌 사람은, "내 uid를 멤버 목록에 추가하는 것"만 허용 (초대 코드로 합류)
      allow read, update: if request.auth != null &&
        (
          request.auth.uid in resource.data.members
          ||
          (
            resource.data.members.size() < 2 &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
            request.resource.data.members == resource.data.members.concat([request.auth.uid])
          )
        );

      allow delete: if false;

      // 자유 기록(사건 로그): 증상/메모 등 - 가구 멤버만 읽고 쓸 수 있음, 수정은 불가(기록은 남기고 지우지 않음)
      match /events/{eventId} {
        allow read, create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
        allow update, delete: if false;
      }

      // 오늘의 컨디션 체크인 (문서ID = 날짜) - 가구 멤버만 읽고 쓸 수 있음
      match /checkins/{checkinId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }

      // 자유 추가형 할 일 - 가구 멤버만 읽고 쓸 수 있음 (완료 체크, 삭제 포함)
      match /todos/{todoId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }
    }
  }
}
